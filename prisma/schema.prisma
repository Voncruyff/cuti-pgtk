generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_UTAMA
  ADMIN_BAGIAN
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(200)
  role         UserRole  @default(ADMIN_BAGIAN)
  department   String?   @db.VarChar(100)
  fotoProfil   String?   @db.LongText @map("foto_profil")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Department {
  id        String    @id @default(uuid())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(150)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  stations  Station[]

  @@index([isActive])
  @@map("bagian")
}

model Station {
  id           String      @id @default(uuid())
  code         String      @unique @db.VarChar(50) // KOBAG
  name         String      @db.VarChar(150)        // NABAG
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  employees    Employee[]

  @@index([isActive])
  @@map("stasiun")
}

model Employee {
  id                String            @id @default(uuid())
  nip               String            @unique @db.VarChar(50)
  nama              String            @db.VarChar(200)
  jabatan           String            @db.VarChar(150)
  bagian            String            @db.VarChar(100)
  category          String            @default("PIMPINAN") @db.VarChar(50) // PIMPINAN / PELAKSANA
  stationId         String?           @map("station_id")
  stasiun           String?           @db.VarChar(150) // Stasiun
  station           Station?          @relation(fields: [stationId], references: [id], onDelete: SetNull)
  leaveBalance      LeaveBalance?
  balanceActivities BalanceActivity[]
  appointmentDate   DateTime?         @map("tgl_pengangkatan")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([bagian])
  @@index([category])
  @@index([isActive])
  @@index([nama])
  @@map("karyawan")
}

model LeaveBalance {
  id           String    @id @default(uuid())
  nip          String    @unique @db.VarChar(50)
  nama         String    @db.VarChar(200)
  employee     Employee  @relation(fields: [nip], references: [nip], onDelete: Cascade)

  // Saldo Cuti diurutkan:
  // 1. Cuti Tahunan
  cutiTahunan  Int       @default(12) @map("cuti_tahunan")

  // 2. Cuti Besar
  cutiBesar    Int       @default(0) @map("cuti_besar")

  // 3. Inhaldagen
  inhaldagen   Int       @default(0) @map("inhaldagen")

  // Total saldo akumulasi
  total        Int       @default(12) @map("total_saldo")

  // Periode Tahun
  periode      Int       @default(2026) @map("periode_tahun")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([periode])
  @@map("saldo_cuti")
}

model BalanceActivity {
  id             String    @id @default(uuid())
  nip            String    @db.VarChar(50)
  nama           String    @default("") @db.VarChar(200)
  employee       Employee  @relation(fields: [nip], references: [nip], onDelete: Cascade)
  jenisTransaksi String    @map("jenis_transaksi") @db.VarChar(20) // AMBIL_CUTI / TAMBAH_SALDO
  uraian         String    @default("") @map("uraian") @db.VarChar(255) // Uraian aktivitas
  tglTransaksi   DateTime  @default(now()) @map("tgl_transaksi")
  tglCuti        String?   @db.Text @map("tgl_cuti") // Daftar tanggal cuti (jika AMBIL_CUTI)
  cutiTahunan    Int       @default(0) @map("cuti_tahunan")
  cutiBesar      Int       @default(0) @map("cuti_besar")
  inhaldagen     Int       @default(0) @map("inhaldagen")
  totalHari      Int       @default(0) @map("total_hari")
  keperluan      String?   @db.VarChar(255) @map("keperluan")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([nip])
  @@index([jenisTransaksi])
  @@index([tglTransaksi])
  @@index([nip, tglTransaksi])
  @@map("aktivitas_saldo")
}

model OtomasiSaldoCuti {
  id              String   @id @default(uuid())
  jenisCuti       String   @unique @db.VarChar(50) @map("jenis_cuti") // CUTI_TAHUNAN, CUTI_BESAR
  namaKebijakan   String   @db.VarChar(100) @map("nama_kebijakan")
  isOtomatisAktif Boolean  @default(true) @map("is_otomatis_aktif")
  saldoDiberikan  Int      @default(12) @map("saldo_diberikan")
  satuanSaldo     String   @default("HARI") @map("satuan_saldo") @db.VarChar(20)
  minMasaKerja    Int      @default(1) @map("min_masa_kerja")
  satuanMasaKerja String   @default("TAHUN") @map("satuan_masa_kerja") @db.VarChar(20)
  siklusUlang     Int      @default(1) @map("siklus_ulang")
  satuanSiklus    String   @default("TAHUN") @map("satuan_siklus") @db.VarChar(20)
  masaBerlaku     Int      @default(1) @map("masa_berlaku")
  satuanBerlaku   String   @default("TAHUN") @map("satuan_berlaku") @db.VarChar(20)
  isCarryOver     Boolean  @default(true) @map("is_carry_over")
  maxCarryOver    Int      @default(6) @map("max_carry_over")
  satuanCarryOver String   @default("HARI") @map("satuan_carry_over") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("otomasi_saldo_cuti")
}

model ProfilPerusahaan {
  id                 String   @id @default("DEFAULT_PROFILE")
  companyName        String   @default("PT KEBON AGUNG") @map("nama_perusahaan") @db.VarChar(200)
  unitName           String   @default("PABRIK GULA TRANGKIL") @map("nama_unit") @db.VarChar(200)
  location           String   @default("Trangkil, Pati, Jawa Tengah") @map("lokasi") @db.VarChar(255)
  hrManagerName      String   @default("Hendra Wijaya, S.E.") @map("nama_sdm") @db.VarChar(200)
  hrManagerNip       String   @default("198503152010011002") @map("nip_sdm") @db.VarChar(50)
  hrManagerTitle     String   @default("Kepala Bagian SDM & Umum") @map("jabatan_sdm") @db.VarChar(150)
  generalManagerName String   @default("Ir. Bambang Santoso, M.M.") @map("nama_gm") @db.VarChar(200)
  generalManagerNip  String   @default("197805122003121001") @map("nip_gm") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("profil_perusahaan")
}



